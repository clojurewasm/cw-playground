{;; Top-level :deps stay empty: the server runs on cljw, which resolves every
 ;; top-level dep at startup and refuses to start on the JVM-only frontend
 ;; toolchain.
 ;; shadow-cljs.edn activates :cljs.
 :paths ["src" "resources"]
 :deps {}
 :aliases
 {:cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "3.4.11"}
                      io.factorhouse/hsx   {:mvn/version "0.1.24"}
                      io.factorhouse/rfx   {:mvn/version "0.1.18"}}}
  :dev {:extra-deps {binaryage/devtools {:mvn/version "1.0.7"}}}
  ;; Run the in-process (babashka-free) backend ON cljw:
  ;;   cljw -M:cljw -m playground.server   (D-355)
  :cljw {:extra-paths ["server"]}}}
